{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "prConcurrentLimit": 5,
  "ignorePaths": [
    "local/**",
    "**/node_modules/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Default images of the node stack, in the code, its tests and the docs",
      "managerFilePatterns": [
        "/^src/nativeMain/kotlin/homegap/config/AppConfig\\.kt$/",
        "/^src/nativeTest/kotlin/homegap/.+\\.kt$/",
        "/^docs/configuration/reference\\.md$/"
      ],
      "matchStrings": [
        "docker\\.io/(?<depName>traefik|crowdsecurity/crowdsec|library/python):(?<currentValue>[A-Za-z0-9][A-Za-z0-9.-]*)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Version of the CrowdSec bouncer plugin for Traefik",
      "managerFilePatterns": [
        "/^src/nativeMain/kotlin/homegap/config/AppConfig\\.kt$/",
        "/^docs/configuration/reference\\.md$/"
      ],
      "matchStrings": [
        "val crowdsecBouncerVersion: String = \"(?<currentValue>v[0-9.]+)\"",
        "`crowdsec_bouncer_version` \\| string \\| `(?<currentValue>v[0-9.]+)`"
      ],
      "depNameTemplate": "maxlerebourg/crowdsec-bouncer-traefik-plugin",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Lego release that the image builds download. Change the SHA-256 values by hand in the same pull request.",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/",
        "/^e2e/.+\\.Dockerfile$/"
      ],
      "matchStrings": [
        "ARG LEGO_VERSION=(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "go-acme/lego",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "The image of the mesh namespace never changes: a new image restarts the mesh.",
      "matchPackageNames": [
        "busybox",
        "docker.io/library/busybox"
      ],
      "enabled": false
    },
    {
      "description": "The HomeGAP images get their version at a release",
      "matchPackageNames": [
        "/^ghcr\\.io/drewcarlson/homegap/"
      ],
      "enabled": false
    }
  ]
}
