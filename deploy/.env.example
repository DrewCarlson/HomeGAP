# The secrets and the settings of the HomeGAP stack. Copy this file to .env, and give .env
# mode 600. Never commit .env.

# The API key of your Bunny account. Necessary.
BUNNY_API_KEY=

# The Pangolin EE license. Optional. The config names it in pangolin.license_key_env.
PANGOLIN_LICENSE_KEY=

# The bearer token of the dashboard: a long random string. If it is empty, HomeGAP makes a
# token and keeps it in its data volume.
HOMEGAP_DASHBOARD_TOKEN=

# The name of the Docker network of your Traefik.
#TRAEFIK_NETWORK=traefik

# Cluster mode: starts the mesh and the homelab's member of the cluster database. Set it together
# with `cluster:` in the config.
#COMPOSE_PROFILES=cluster

# The folder of everything that HomeGAP writes. The default is ./data, next to compose.yml.
#HOMEGAP_DATA_DIR=./data

# The image tag. Without it, the stack uses the newest release (latest). "0.1" follows the patch
# releases of 0.1, "0" follows major version 0, and "0.1.0" stays on that one release.
#HOMEGAP_VERSION=0.1

# Where the host publishes the dashboard. The default is the loopback address only.
#HOMEGAP_DASHBOARD_PUBLISH=127.0.0.1:8088

# "true" starts the orchestrator in dry run: it reads everything and writes nothing.
#HOMEGAP_DRY_RUN=true
